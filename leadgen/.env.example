# Postgres connection. Leave unset to use an embedded PGlite database in ./.pglite (dev only).
DATABASE_URL=

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Front Range Roof Quotes"
NEXT_PUBLIC_TRUSTEDFORM_ENABLED=false

# Admin dashboard: single shared password (MVP). Rotate before launch.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-32-chars-minimum-please

# Buyer adapters
# Modernize (QuinStreet) Publisher Ping Post v3. Staging tagId from docs; production from your account manager.
MODERNIZE_ENABLED=false
MODERNIZE_TAG_ID=204670250
MODERNIZE_PARTNER_SOURCE_ID=
MODERNIZE_PING_URL=https://api-staging.modernize.com/publishers/v3/ping
MODERNIZE_POST_URL=https://api-staging.modernize.com/publishers/v3/post

# Generic ping/post buyer (Prime Lead Exchange, Networx, etc). JSON config, see src/lib/buyers/generic.ts
GENERIC_BUYER_JSON=

# Inbound webhook auth for buyer dispositions (Service Direct Direct Sync etc)
WEBHOOK_SECRET=

# Fraud/abuse
LEAD_RATE_LIMIT_PER_IP_PER_HOUR=5
